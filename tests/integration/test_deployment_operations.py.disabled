class TestRollbackMechanisms:
    """Test rollback mechanisms and disaster recovery"""
    
    @pytest.mark.asyncio
    async def test_code_rollback_tc_deploy_017(
        self,
        rollback_service: RollbackService,
        deployment_service: DeploymentService
    ):
        """TC-DEPLOY-017: Test code rollback mechanism"""
        # Create deployment history
        deployments = [
            {"version": "v1.0.0", "timestamp": datetime.utcnow() - timedelta(days=7)},
            {"version": "v1.1.0", "timestamp": datetime.utcnow() - timedelta(days=3)},
            {"version": "v1.2.0", "timestamp": datetime.utcnow() - timedelta(hours=1)}
        ]
        
        for deployment in deployments:
            await deployment_service.record_deployment(
                version=deployment["version"],
                timestamp=deployment["timestamp"],
                status="completed"
            )
        
        # Initiate rollback to previous version
        rollback_result = await rollback_service.rollback_to_version(
            target_version="v1.1.0",
            reason="Critical bug in v1.2.0"
        )
        
        assert rollback_result["status"] == "completed"
        assert rollback_result["from_version"] == "v1.2.0"
        assert rollback_result["to_version"] == "v1.1.0"
        assert rollback_result["duration_seconds"] < 300  # Under 5 minutes
        
        # Verify rollback
        current_version = await deployment_service.get_current_version()
        assert current_version == "v1.1.0"
    
    @pytest.mark.asyncio
    async def test_database_rollback_tc_deploy_018(
        self,
        rollback_service: RollbackService,
        db: AsyncSession
    ):
        """TC-DEPLOY-018: Test database schema rollback"""
        # Apply migration
        migration = {
            "version": "20240116_add_feature_table",
            "up_sql": """
                CREATE TABLE feature_flags (
                    id SERIAL PRIMARY KEY,
                    name VARCHAR(100) UNIQUE,
                    enabled BOOLEAN DEFAULT false
                );
            """,
            "down_sql": "DROP TABLE IF EXISTS feature_flags;"
        }
        
        # Apply forward migration
        await db.execute(migration["up_sql"])
        await db.commit()
        
        # Verify table exists
        result = await db.execute("""
            SELECT EXISTS (
                SELECT FROM information_schema.tables 
                WHERE table_name = 'feature_flags'
            )
        """)
        assert result.scalar() is True
        
        # Rollback migration
        rollback_result = await rollback_service.rollback_migration(
            migration_version=migration["version"],
            down_sql=migration["down_sql"]
        )
        
        assert rollback_result["status"] == "rolled_back"
        
        # Verify table removed
        result = await db.execute("""
            SELECT EXISTS (
                SELECT FROM information_schema.tables 
                WHERE table_name = 'feature_flags'
            )
        """)
        assert result.scalar() is False
    
    @pytest.mark.asyncio
    async def test_configuration_rollback_tc_deploy_019(
        self,
        rollback_service: RollbackService
    ):
        """TC-DEPLOY-019: Test configuration rollback"""
        # Create configuration snapshots
        config_v1 = {
            "version": "config-v1",
            "timestamp": datetime.utcnow() - timedelta(hours=2),
            "settings": {
                "rate_limit": 100,
                "cache_ttl": 3600,
                "feature_flags": {
                    "new_ui": False,
                    "beta_features": False
                }
            }
        }
        
        config_v2 = {
            "version": "config-v2",
            "timestamp": datetime.utcnow(),
            "settings": {
                "rate_limit": 50,  # Problematic change
                "cache_ttl": 1800,
                "feature_flags": {
                    "new_ui": True,
                    "beta_features": True
                }
            }
        }
        
        # Save configurations
        await rollback_service.save_configuration_snapshot(config_v1)
        await rollback_service.save_configuration_snapshot(config_v2)
        
        # Rollback to previous configuration
        rollback_result = await rollback_service.rollback_configuration(
            target_version="config-v1",
            reason="Rate limit too restrictive"
        )
        
        assert rollback_result["status"] == "completed"
        assert rollback_result["changes_reverted"] == 3
        
        # Verify configuration restored
        current_config = await rollback_service.get_current_configuration()
        assert current_config["settings"]["rate_limit"] == 100
        assert current_config["settings"]["feature_flags"]["new_ui"] is False
    
    @pytest.mark.asyncio
    async def test_disaster_recovery_tc_deploy_020(
        self,
        rollback_service: RollbackService,
        db: AsyncSession
    ):
        """TC-DEPLOY-020: Test disaster recovery procedures"""
        # Create backup point
        backup_result = await rollback_service.create_backup(
            backup_type="full",
            components=["database", "redis", "files"],
            description="Pre-deployment backup"
        )
        
        assert backup_result["status"] == "completed"
        assert backup_result["backup_id"] is not None
        assert all(c["status"] == "completed" for c in backup_result["components"])
        
        # Simulate disaster scenario
        disaster_scenario = {
            "type": "data_corruption",
            "affected_tables": ["users", "devices"],
            "corruption_detected_at": datetime.utcnow()
        }
        
        # Initiate disaster recovery
        recovery_result = await rollback_service.initiate_disaster_recovery(
            backup_id=backup_result["backup_id"],
            scenario=disaster_scenario
        )
        
        assert recovery_result["status"] == "completed"
        assert recovery_result["data_restored"] is True
        assert recovery_result["recovery_time_minutes"] < 240  # RTO under 4 hours
        
        # Verify data integrity after recovery
        integrity_check = await rollback_service.verify_data_integrity()
        assert integrity_check["all_checks_passed"] is True
        assert len(integrity_check["errors"]) == 0


class TestFeatureFlagManagement:
    """Test feature flag management during deployments"""
    
    @pytest.mark.asyncio
    async def test_feature_flag_creation_tc_deploy_021(
        self,
        feature_flag_service: FeatureFlagService,
        db: AsyncSession
    ):
        """TC-DEPLOY-021: Test feature flag creation and management"""
        # Create feature flag
        flag_config = {
            "name": "enhanced_search",
            "description": "New search algorithm with ML",
            "type": "boolean",
            "default_value": False,
            "environments": {
                "development": True,
                "staging": True,
                "production": False
            },
            "tags": ["search", "ml", "experimental"]
        }
        
        flag = await feature_flag_service.create_flag(flag_config)
        
        assert flag["id"] is not None
        assert flag["name"] == "enhanced_search"
        assert flag["created_at"] is not None
        
        # Test flag evaluation
        contexts = [
            {"environment": "development", "expected": True},
            {"environment": "production", "expected": False},
            {"environment": "unknown", "expected": False}  # Default
        ]
        
        for context in contexts:
            is_enabled = await feature_flag_service.evaluate_flag(
                flag_name="enhanced_search",
                context={"environment": context["environment"]}
            )
            assert is_enabled == context["expected"]
    
    @pytest.mark.asyncio
    async def test_percentage_rollout_tc_deploy_022(
        self,
        feature_flag_service: FeatureFlagService
    ):
        """TC-DEPLOY-022: Test percentage-based feature rollout"""
        # Create flag with percentage rollout
        flag_config = {
            "name": "new_dashboard",
            "type": "boolean",
            "default_value": False,
            "rollout_strategy": {
                "type": "percentage",
                "percentage": 25,  # 25% of users
                "sticky": True  # Same users always get the feature
            }
        }
        
        flag = await feature_flag_service.create_flag(flag_config)
        
        # Test distribution across many users
        enabled_count = 0
        total_users = 1000
        
        user_decisions = {}
        for user_id in range(total_users):
            is_enabled = await feature_flag_service.evaluate_flag(
                flag_name="new_dashboard",
                context={"user_id": user_id}
            )
            user_decisions[user_id] = is_enabled
            if is_enabled:
                enabled_count += 1
        
        # Check percentage is roughly correct (allow 5% variance)
        expected_percentage = 25
        actual_percentage = (enabled_count / total_users) * 100
        assert abs(actual_percentage - expected_percentage) < 5
        
        # Verify stickiness - same user always gets same decision
        for user_id in range(100):  # Test subset
            second_evaluation = await feature_flag_service.evaluate_flag(
                flag_name="new_dashboard",
                context={"user_id": user_id}
            )
            assert second_evaluation == user_decisions[user_id]
    
    @pytest.mark.asyncio
    async def test_targeted_rollout_tc_deploy_023(
        self,
        feature_flag_service: FeatureFlagService,
        db: AsyncSession
    ):
        """TC-DEPLOY-023: Test targeted feature rollout"""
        # Create organizations and users for testing
        orgs = []
        for i in range(3):
            org = await OrganizationFactory.create(
                name=f"Test Hospital {i}",
                type="hospital"
            )
            orgs.append(org)
        
        # Create flag with targeting rules
        flag_config = {
            "name": "advanced_analytics",
            "type": "boolean",
            "default_value": False,
            "targeting_rules": [
                {
                    "condition": {
                        "attribute": "organization_id",
                        "operator": "in",
                        "values": [orgs[0].id, orgs[1].id]
                    },
                    "value": True
                },
                {
                    "condition": {
                        "attribute": "role",
                        "operator": "equals",
                        "value": "super_admin"
                    },
                    "value": True
                },
                {
                    "condition": {
                        "attribute": "email",
                        "operator": "ends_with",
                        "value": "@beta.nyelux.com"
                    },
                    "value": True
                }
            ]
        }
        
        flag = await feature_flag_service.create_flag(flag_config)
        
        # Test targeting rules
        test_cases = [
            {
                "context": {"organization_id": orgs[0].id, "role": "nurse"},
                "expected": True  # Matches org rule
            },
            {
                "context": {"organization_id": orgs[2].id, "role": "nurse"},
                "expected": False  # No match
            },
            {
                "context": {"organization_id": orgs[2].id, "role": "super_admin"},
                "expected": True  # Matches role rule
            },
            {
                "context": {"email": "tester@beta.nyelux.com", "role": "user"},
                "expected": True  # Matches email rule
            }
        ]
        
        for test_case in test_cases:
            is_enabled = await feature_flag_service.evaluate_flag(
                flag_name="advanced_analytics",
                context=test_case["context"]
            )
            assert is_enabled == test_case["expected"]
    
    @pytest.mark.asyncio
    async def test_flag_audit_trail_tc_deploy_024(
        self,
        feature_flag_service: FeatureFlagService,
        db: AsyncSession
    ):
        """TC-DEPLOY-024: Test feature flag audit trail"""
        # Create and modify flag
        flag = await feature_flag_service.create_flag({
            "name": "test_feature",
            "type": "boolean",
            "default_value": False
        })
        
        # Make changes
        changes = [
            {"action": "update_value", "value": True},
            {"action": "add_rule", "rule": {"attribute": "role", "operator": "equals", "value": "admin"}},
            {"action": "update_percentage", "percentage": 50},
            {"action": "disable", "reason": "Bug found"}
        ]
        
        for change in changes:
            if change["action"] == "update_value":
                await feature_flag_service.update_flag(
                    flag_name="test_feature",
                    default_value=change["value"]
                )
            elif change["action"] == "disable":
                await feature_flag_service.disable_flag(
                    flag_name="test_feature",
                    reason=change["reason"]
                )
            # Add other change types...
        
        # Get audit trail
        audit_trail = await feature_flag_service.get_flag_audit_trail(
            flag_name="test_feature"
        )
        
        assert len(audit_trail) >= len(changes) + 1  # +1 for creation
        
        # Verify audit entries
        for entry in audit_trail:
            assert "timestamp" in entry
            assert "action" in entry
            assert "user_id" in entry or "system" in entry
            assert "changes" in entry
        
        # Check specific audit entry
        creation_entry = next(e for e in audit_trail if e["action"] == "created")
        assert creation_entry is not None
        assert creation_entry["changes"]["name"] == "test_feature"


class TestContinuousDeployment:
    """Test continuous deployment automation"""
    
    @pytest.mark.asyncio
    async def test_ci_cd_pipeline_integration_tc_deploy_025(
        self,
        deployment_service: DeploymentService
    ):
        """TC-DEPLOY-025: Test CI/CD pipeline integration"""
        # Simulate CI/CD webhook
        pipeline_event = {
            "event_type": "push",
            "branch": "main",
            "commit_sha": "abc123def456",
            "commit_message": "feat: Add new device comparison feature",
            "author": "developer@nyelux.com",
            "timestamp": datetime.utcnow().isoformat(),
            "ci_status": "passed",
            "test_results": {
                "total": 1500,
                "passed": 1500,
                "failed": 0,
                "coverage": 92.5
            }
        }
        
        # Process pipeline event
        deployment_decision = await deployment_service.process_pipeline_event(
            event=pipeline_event
        )
        
        assert deployment_decision["should_deploy"] is True
        assert deployment_decision["deployment_type"] == "automatic"
        assert deployment_decision["target_environment"] == "staging"
        
        # Verify deployment triggered
        deployment = await deployment_service.get_latest_deployment()
        assert deployment["commit_sha"] == pipeline_event["commit_sha"]
        assert deployment["triggered_by"] == "ci_pipeline"
    
    @pytest.mark.asyncio
    async def test_automated_rollback_criteria_tc_deploy_026(
        self,
        deployment_service: DeploymentService,
        monitoring_service: MonitoringService
    ):
        """TC-DEPLOY-026: Test automated rollback based on metrics"""
        # Configure rollback criteria
        rollback_config = {
            "enabled": True,
            "monitoring_period_minutes": 15,
            "criteria": [
                {
                    "metric": "error_rate",
                    "threshold": 0.05,  # 5%
                    "comparison": "greater_than"
                },
                {
                    "metric": "response_time_p99",
                    "threshold": 1000,  # 1 second
                    "comparison": "greater_than"
                },
                {
                    "metric": "apdex_score",
                    "threshold": 0.8,
                    "comparison": "less_than"
                }
            ]
        }
        
        deployment_id = await deployment_service.start_deployment(
            config={"rollback_config": rollback_config}
        )
        
        # Simulate metric degradation
        await monitoring_service.record_metric("error_rate", 0.08)  # 8% errors
        await monitoring_service.record_metric("response_time_p99", 1500)  # 1.5s
        await monitoring_service.record_metric("apdex_score", 0.7)  # Below threshold
        
        # Check if rollback triggered
        rollback_check = await deployment_service.check_automated_rollback(
            deployment_id=deployment_id
        )
        
        assert rollback_check["should_rollback"] is True
        assert len(rollback_check["triggered_criteria"]) == 3
        assert rollback_check["recommendation"] == "immediate_rollback"
    
    @pytest.mark.asyncio
    async def test_gradual_rollout_with_monitoring_tc_deploy_027(
        self,
        deployment_service: DeploymentService,
        monitoring_service: MonitoringService
    ):
        """TC-DEPLOY-027: Test gradual rollout with continuous monitoring"""
        # Configure gradual rollout
        rollout_config = {
            "strategy": "gradual",
            "stages": [
                {"percentage": 1, "duration_minutes": 30, "name": "canary"},
                {"percentage": 5, "duration_minutes": 60, "name": "early_adopters"},
                {"percentage": 25, "duration_minutes": 120, "name": "quarter"},
                {"percentage": 50, "duration_minutes": 240, "name": "half"},
                {"percentage": 100, "duration_minutes": None, "name": "full"}
            ],
            "pause_on_errors": True,
            "success_criteria": {
                "error_rate_max": 0.02,
                "customer_complaints_max": 5
            }
        }
        
        deployment_id = await deployment_service.start_gradual_rollout(
            config=rollout_config,
            version="v2.1.0"
        )
        
        # Simulate progression through stages
        for stage in rollout_config["stages"]:
            # Update rollout percentage
            await deployment_service.update_rollout_stage(
                deployment_id=deployment_id,
                stage_name=stage["name"],
                percentage=stage["percentage"]
            )
            
            # Monitor metrics during stage
            stage_metrics = await monitoring_service.get_stage_metrics(
                deployment_id=deployment_id,
                stage_name=stage["name"]
            )
            
            # Verify metrics within bounds
            assert stage_metrics["error_rate"] < rollout_config["success_criteria"]["error_rate_max"]
            assert stage_metrics["user_satisfaction"] > 4.0  # Out of 5
            
            # Check if we should proceed
            proceed_decision = await deployment_service.should_proceed_to_next_stage(
                deployment_id=deployment_id,
                current_stage=stage["name"]
            )
            
            assert proceed_decision["can_proceed"] is True
    
    @pytest.mark.asyncio
    async def test_deployment_approval_workflow_tc_deploy_028(
        self,
        deployment_service: DeploymentService,
        db: AsyncSession
    ):
        """TC-DEPLOY-028: Test deployment approval workflow"""
        # Create approval workflow
        workflow_config = {
            "production_deployment": {
                "required_approvals": 2,
                "approvers": [
                    {"role": "engineering_manager", "required": True},
                    {"role": "product_manager", "required": True},
                    {"role": "qa_lead", "required": False}
                ],
                "auto_approve_after_hours": 24,
                "block_on_failing_tests": True
            }
        }
        
        # Request deployment approval
        approval_request = await deployment_service.request_deployment_approval(
            version="v2.2.0",
            environment="production",
            changes_summary="New AI features and bug fixes",
            workflow=workflow_config["production_deployment"]
        )
        
        assert approval_request["status"] == "pending_approval"
        assert approval_request["approvals_received"] == 0
        assert approval_request["approvals_required"] == 2
        
        # Add approvals
        approval1 = await deployment_service.add_approval(
            request_id=approval_request["id"],
            approver_id=1,
            approver_role="engineering_manager",
            decision="approved",
            comments="LGTM, tests pass"
        )
        
        assert approval1["approvals_received"] == 1
        assert approval1["status"] == "pending_approval"
        
        approval2 = await deployment_service.add_approval(
            request_id=approval_request["id"],
            approver_id=2,
            approver_role="product_manager",
            decision="approved",
            comments="Features verified in staging"
        )
        
        assert approval2["approvals_received"] == 2
        assert approval2["status"] == "approved"
        assert approval2["can_deploy"] is True
    
    @pytest.mark.asyncio
    async def test_deployment_scheduling_tc_deploy_029(
        self,
        deployment_service: DeploymentService
    ):
        """TC-DEPLOY-029: Test deployment scheduling and windows"""
        # Configure deployment windows
        deployment_windows = {
            "production": {
                "allowed_days": ["Tuesday", "Thursday"],
                "allowed_hours": {"start": 14, "end": 16},  # 2-4 PM
                "timezone": "America/New_York",
                "blackout_dates": [
                    "2024-12-24",  # Christmas Eve
                    "2024-12-25",  # Christmas
                    "2024-12-31",  # New Year's Eve
                    "2025-01-01"   # New Year's Day
                ]
            }
        }
        
        # Test deployment scheduling
        proposed_time = datetime(2024, 1, 16, 15, 0)  # Tuesday 3 PM
        
        is_allowed = await deployment_service.is_deployment_allowed(
            environment="production",
            proposed_time=proposed_time,
            windows_config=deployment_windows
        )
        
        assert is_allowed is True
        
        # Test blackout date
        blackout_time = datetime(2024, 12, 25, 15, 0)
        is_allowed_blackout = await deployment_service.is_deployment_allowed(
            environment="production",
            proposed_time=blackout_time,
            windows_config=deployment_windows
        )
        
        assert is_allowed_blackout is False
        
        # Find next available window
        next_window = await deployment_service.get_next_deployment_window(
            environment="production",
            after=datetime.utcnow(),
            windows_config=deployment_windows
        )
        
        assert next_window is not None
        assert next_window.strftime("%A") in deployment_windows["production"]["allowed_days"]
    
    @pytest.mark.asyncio
    async def test_multi_region_deployment_tc_deploy_030(
        self,
        deployment_service: DeploymentService
    ):
        """TC-DEPLOY-030: Test multi-region deployment coordination"""
        # Configure regions
        regions = [
            {"name": "us-east-1", "primary": True, "weight": 40},
            {"name": "us-west-2", "primary": False, "weight": 30},
            {"name": "eu-west-1", "primary": False, "weight": 20},
            {"name": "ap-southeast-1", "primary": False, "weight": 10}
        ]
        
        # Start multi-region deployment
        deployment_plan = await deployment_service.create_multi_region_deployment(
            version="v2.3.0",
            regions=regions,
            strategy="rolling",  # Deploy one region at a time
            delay_between_regions_minutes=30
        )
        
        assert len(deployment_plan["stages"]) == len(regions)
        assert deployment_plan["stages"][0]["region"] == "us-east-1"  # Primary first
        
        # Execute deployment to each region
        for stage in deployment_plan["stages"]:
            region_deployment = await deployment_service.deploy_to_region(
                deployment_id=deployment_plan["id"],
                region=stage["region"],
                version="v2.3.0"
            )
            
            assert region_deployment["status"] == "in_progress"
            
            # Simulate successful deployment
            await deployment_service.mark_region_deployed(
                deployment_id=deployment_plan["id"],
                region=stage["region"],
                success=True
            )
            
            # Verify traffic shifting
            traffic_config = await deployment_service.get_traffic_configuration()
            assert traffic_config["regions"][stage["region"]]["version"] == "v2.3.0"
        
        # Verify all regions deployed
        final_status = await deployment_service.get_deployment_status(
            deployment_id=deployment_plan["id"]
        )
        
        assert final_status["regions_deployed"] == len(regions)
        assert final_status["overall_status"] == "completed"


class TestDockerContainerManagement:
    """Test Docker container and image management"""
    
    @pytest.mark.asyncio
    async def test_docker_image_build_tc_deploy_031(
        self,
        deployment_service: DeploymentService
    ):
        """TC-DEPLOY-031: Test Docker image building process"""
        # Build configuration
        build_config = {
            "dockerfile": "Dockerfile.production",
            "context": ".",
            "build_args": {
                "PYTHON_VERSION": "3.11",
                "APP_VERSION": "2.4.0",
                "BUILD_DATE": datetime.utcnow().isoformat()
            },
            "target": "production",
            "cache_from": ["nyelux/backend:latest"],
            "labels": {
                "version": "2.4.0",
                "commit": "abc123",
                "build_number": "456"
            }
        }
        
        # Start build
        build_result = await deployment_service.build_docker_image(
            config=build_config,
            tag="nyelux/backend:2.4.0"
        )
        
        assert build_result["status"] == "success"
        assert build_result["image_id"] is not None
        assert build_result["size_mb"] < 500  # Keep image size reasonable
        
        # Verify image
        docker_client = docker.from_env()
        image = docker_client.images.get("nyelux/backend:2.4.0")
        
        assert image is not None
        assert "2.4.0" in image.tags
        
        # Test multi-stage build efficiency
        assert len(image.history()) < 50  # Reasonable number of layers
    
    @pytest.mark.asyncio
    async def test_container_health_checks_tc_deploy_032(
        self,
        deployment_service: DeploymentService
    ):
        """TC-DEPLOY-032: Test container health check configuration"""
        # Container configuration with health check
        container_config = {
            "image": "nyelux/backend:latest",
            "name": "nyelux-api",
            "health_check": {
                "test": ["CMD", "curl", "-f", "http://localhost:8000/health"],
                "interval": 30,  # seconds
                "timeout": 10,   # seconds
                "retries": 3,
                "start_period": 60  # seconds
            },
            "restart_policy": {
                "name": "unless-stopped",
                "maximum_retry_count": 5
            }
        }
        
        # Start container
        container = await deployment_service.start_container(
            config=container_config
        )
        
        assert container["status"] == "running"
        
        # Wait for health check
        await asyncio.sleep(container_config["health_check"]["start_period"] + 10)
        
        # Check container health
        health_status = await deployment_service.get_container_health(
            container_name="nyelux-api"
        )
        
        assert health_status["status"] == "healthy"
        assert health_status["failing_streak"] == 0
        
        # Test unhealthy scenario
        await deployment_service.simulate_container_issue(
            container_name="nyelux-api",
            issue_type="health_check_failure"
        )
        
        # Verify restart behavior
        await asyncio.sleep(container_config["health_check"]["interval"] * 4)
        
        container_info = await deployment_service.get_container_info(
            container_name="nyelux-api"
        )
        
        assert container_info["restart_count"] > 0
        assert container_info["status"] in ["running", "restarting"]
    
    @pytest.mark.asyncio
    async def test_container_resource_limits_tc_deploy_033(
        self,
        deployment_service: DeploymentService
    ):
        """TC-DEPLOY-033: Test container resource limits and monitoring"""
        # Configure resource limits
        resource_config = {
            "memory": {
                "limit": "2g",
                "reservation": "1g"
            },
            "cpu": {
                "limit": 2.0,  # 2 CPUs
                "reservation": 0.5  # 0.5 CPU
            },
            "pids": {
                "limit": 1000  # Max processes
            },
            "ulimits": [
                {"name": "nofile", "soft": 65536, "hard": 65536},
                {"name": "nproc", "soft": 4096, "hard": 4096}
            ]
        }
        
        # Start container with limits
        container = await deployment_service.start_container_with_limits(
            image="nyelux/backend:latest",
            resources=resource_config
        )
        
        # Monitor resource usage
        usage_stats = await deployment_service.get_container_stats(
            container_id=container["id"]
        )
        
        assert usage_stats["memory"]["usage_mb"] < 2048  # Under limit
        assert usage_stats["cpu"]["usage_percent"] < 200  # Under 2 CPUs
        
        # Test OOM killer protection
        stress_test_result = await deployment_service.stress_test_container(
            container_id=container["id"],
            test_type="memory",
            target_usage_mb=2500  # Over limit
        )
        
        assert stress_test_result["oom_killed"] is False
        assert stress_test_result["memory_limited"] is True
    
    @pytest.mark.asyncio
    async def test_image_vulnerability_scanning_tc_deploy_034(
        self,
        deployment_service: DeploymentService
    ):
        """TC-DEPLOY-034: Test container image vulnerability scanning"""
        # Scan image for vulnerabilities
        scan_result = await deployment_service.scan_image_vulnerabilities(
            image="nyelux/backend:latest",
            scan_type="comprehensive"
        )
        
        assert scan_result["scan_completed"] is True
        assert "vulnerabilities" in scan_result
        
        # Check vulnerability levels
        vulns = scan_result["vulnerabilities"]
        assert "critical" in vulns
        assert "high" in vulns
        assert "medium" in vulns
        assert "low" in vulns
        
        # Verify no critical vulnerabilities (deployment gate)
        assert vulns["critical"]["count"] == 0
        
        # Check specific vulnerability types
        if vulns["high"]["count"] > 0:
            high_vuln = vulns["high"]["items"][0]
            assert "cve_id" in high_vuln
            assert "package" in high_vuln
            assert "fixed_version" in high_vuln
            assert "severity" in high_vuln
        
        # Test compliance check
        compliance_result = await deployment_service.check_image_compliance(
            image="nyelux/backend:latest",
            policies=["cis-docker-benchmark", "pci-dss"]
        )
        
        assert compliance_result["compliant"] is True
        assert len(compliance_result["violations"]) == 0


class TestKubernetesIntegration:
    """Test Kubernetes deployment and management"""
    
    @pytest.mark.asyncio
    async def test_kubernetes_deployment_tc_deploy_035(
        self,
        deployment_service: DeploymentService
    ):
        """TC-DEPLOY-035: Test Kubernetes deployment creation"""
        # K8s deployment configuration
        k8s_config = {
            "apiVersion": "apps/v1",
            "kind": "Deployment",
            "metadata": {
                "name": "nyelux-backend",
                "namespace": "production",
                "labels": {
                    "app": "nyelux",
                    "component": "backend",
                    "version": "2.5.0"
                }
            },
            "spec": {
                "replicas": 3,
                "selector": {
                    "matchLabels": {
                        "app": "nyelux",
                        "component": "backend"
                    }
                },
                "template": {
                    "metadata": {
                        "labels": {
                            "app": "nyelux",
                            "component": "backend",
                            "version": "2.5.0"
                        }
                    },
                    "spec": {
                        "containers": [{
                            "name": "nyelux-api",
                            "image": "nyelux/backend:2.5.0",
                            "ports": [{"containerPort": 8000}],
                            "resources": {
                                "requests": {"memory": "1Gi", "cpu": "500m"},
                                "limits": {"memory": "2Gi", "cpu": "1000m"}
                            },
                            "livenessProbe": {
                                "httpGet": {"path": "/alive", "port": 8000},
                                "initialDelaySeconds": 60,
                                "periodSeconds": 30
                            },
                            "readinessProbe": {
                                "httpGet": {"path": "/ready", "port": 8000},
                                "initialDelaySeconds": 30,
                                "periodSeconds": 10
                            }
                        }]
                    }
                },
                "strategy": {
                    "type": "RollingUpdate",
                    "rollingUpdate": {
                        "maxSurge": 1,
                        "maxUnavailable": 0
                    }
                }
            }
        }
        
        # Deploy to Kubernetes
        k8s_deployment = await deployment_service.deploy_to_kubernetes(
            config=k8s_config
        )
        
        assert k8s_deployment["status"] == "created"
        assert k8s_deployment["name"] == "nyelux-backend"
        
        # Wait for rollout
        rollout_status = await deployment_service.wait_for_rollout(
            deployment_name="nyelux-backend",
            namespace="production",
            timeout_seconds=300
        )
        
        assert rollout_status["ready"] is True
        assert rollout_status["available_replicas"] == 3
        assert rollout_status["updated_replicas"] == 3
    
    @pytest.mark.asyncio
    async def test_horizontal_pod_autoscaling_tc_deploy_036(
        self,
        deployment_service: DeploymentService
    ):
        """TC-DEPLOY-036: Test Horizontal Pod Autoscaler configuration"""
        # HPA configuration
        hpa_config = {
            "apiVersion": "autoscaling/v2",
            "kind": "HorizontalPodAutoscaler",
            "metadata": {
                "name": "nyelux-backend-hpa",
                "namespace": "production"
            },
            "spec": {
                "scaleTargetRef": {
                    "apiVersion": "apps/v1",
                    "kind": "Deployment",
                    "name": "nyelux-backend"
                },
                "minReplicas": 3,
                "maxReplicas": 10,
                "metrics": [
                    {
                        "type": "Resource",
                        "resource": {
                            "name": "cpu",
                            "target": {
                                "type": "Utilization",
                                "averageUtilization": 70
                            }
                        }
                    },
                    {
                        "type": "Resource",
                        "resource": {
                            "name": "memory",
                            "target": {
                                "type": "Utilization",
                                "averageUtilization": 80
                            }
                        }
                    },
                    {
                        "type": "Pods",
                        "pods": {
                            "metric": {
                                "name": "http_requests_per_second"
                            },
                            "target": {
                                "type": "AverageValue",
                                "averageValue": "1000"
                            }
                        }
                    }
                ],
                "behavior": {
                    "scaleDown": {
                        "stabilizationWindowSeconds": 300,
                        "policies": [{
                            "type": "Percent",
                            "value": 10,
                            "periodSeconds": 60
                        }]
                    },
                    "scaleUp": {
                        "stabilizationWindowSeconds": 60,
                        "policies": [{
                            "type": "Percent",
                            "value": 50,
                            "periodSeconds": 60
                        }]
                    }
                }
            }
        }
        
        # Create HPA
        hpa = await deployment_service.create_hpa(config=hpa_config)
        
        assert hpa["status"] == "created"
        
        # Simulate load increase
        await deployment_service.simulate_load(
            target="nyelux-backend",
            requests_per_second=5000,
            duration_seconds=120
        )
        
        # Check scaling behavior
        await asyncio.sleep(90)  # Wait for HPA to react
        
        scaling_status = await deployment_service.get_hpa_status(
            name="nyelux-backend-hpa",
            namespace="production"
        )
        
        assert scaling_status["current_replicas"] > 3
        assert scaling_status["current_replicas"] <= 10
        assert scaling_status["current_cpu_utilization"] > 70
    
    @pytest.mark.asyncio
    async def test_pod_disruption_budget_tc_deploy_037(
        self,
        deployment_service: DeploymentService
    ):
        """TC-DEPLOY-037: Test Pod Disruption Budget during updates"""
        # PDB configuration
        pdb_config = {
            "apiVersion": "policy/v1",
            "kind": "PodDisruptionBudget",
            "metadata": {
                "name": "nyelux-backend-pdb",
                "namespace": "production"
            },
            "spec": {
                "minAvailable": 2,
                "selector": {
                    "matchLabels": {
                        "app": "nyelux",
                        "component": "backend"
                    }
                }
            }
        }
        
        # Create PDB
