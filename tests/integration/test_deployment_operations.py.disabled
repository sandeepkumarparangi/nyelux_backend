            node_name="worker-node-1",
            drain_timeout_seconds=300
        )
        
        # Verify minimum pods maintained
        assert maintenance_result["pods_evicted"] > 0
        assert maintenance_result["minimum_pods_maintained"] is True
        assert maintenance_result["service_disruption"] is False
    
    @pytest.mark.asyncio
    async def test_configmap_and_secret_management_tc_deploy_038(
        self,
        deployment_service: DeploymentService
    ):
        """TC-DEPLOY-038: Test ConfigMap and Secret management"""
        # Create ConfigMap
        configmap = {
            "apiVersion": "v1",
            "kind": "ConfigMap",
            "metadata": {
                "name": "nyelux-config",
                "namespace": "production"
            },
            "data": {
                "app.properties": """
                    server.port=8000
                    cache.ttl=3600
                    rate.limit=1000
                """,
                "features.json": json.dumps({
                    "new_ui": False,
                    "ai_chat": True,
                    "advanced_search": True
                })
            }
        }
        
        # Create Secret
        secret = {
            "apiVersion": "v1",
            "kind": "Secret",
            "metadata": {
                "name": "nyelux-secret",
                "namespace": "production"
            },
            "type": "Opaque",
            "stringData": {
                "database-url": "postgresql://user:pass@db:5432/nyelux",
                "api-key": "secret-api-key-value",
                "jwt-secret": "super-secret-jwt-key"
            }
        }
        
        # Deploy configurations
        cm_result = await deployment_service.create_configmap(configmap)
        secret_result = await deployment_service.create_secret(secret)
        
        assert cm_result["status"] == "created"
        assert secret_result["status"] == "created"
        
        # Update deployment to use ConfigMap and Secret
        update_result = await deployment_service.update_deployment_config(
            deployment_name="nyelux-backend",
            namespace="production",
            config_sources=[
                {
                    "type": "configmap",
                    "name": "nyelux-config",
                    "mount_path": "/app/config"
                },
                {
                    "type": "secret",
                    "name": "nyelux-secret",
                    "env_prefix": "NYELUX_"
                }
            ]
        )
        
        assert update_result["status"] == "updated"
        assert update_result["rolling_update_triggered"] is True


class TestMonitoringAndAlerts:
    """Test monitoring, alerting, and observability systems"""
    
    @pytest.mark.asyncio
    async def test_prometheus_metrics_export_tc_deploy_039(
        self,
        monitoring_service: MonitoringService,
        client: AsyncClient
    ):
        """TC-DEPLOY-039: Test Prometheus metrics export"""
        # Generate some metrics
        await client.get("/api/v1/devices/search?q=test")
        await client.post("/api/v1/auth/login", json={
            "username": "test@example.com",
            "password": "password"
        })
        
        # Get Prometheus metrics
        response = await client.get("/metrics")
        assert response.status_code == 200
        
        metrics_text = response.text
        
        # Verify standard metrics present
        expected_metrics = [
            "http_requests_total",
            "http_request_duration_seconds",
            "http_requests_in_progress",
            "python_gc_objects_collected_total",
            "python_info",
            "process_virtual_memory_bytes",
            "process_resident_memory_bytes",
            "process_cpu_seconds_total"
        ]
        
        for metric in expected_metrics:
            assert metric in metrics_text
        
        # Verify custom business metrics
        business_metrics = [
            "nyelux_active_users",
            "nyelux_device_searches_total",
            "nyelux_api_errors_total",
            "nyelux_chat_sessions_active",
            "nyelux_document_uploads_total"
        ]
        
        for metric in business_metrics:
            assert metric in metrics_text
        
        # Parse and validate metric format
        families = list(text_string_to_metric_families(metrics_text))
        assert len(families) > 20  # Should have many metrics
        
        # Check specific metric values
        for family in families:
            if family.name == "http_requests_total":
                for sample in family.samples:
                    assert sample.value >= 2  # At least our test requests
    
    @pytest.mark.asyncio
    async def test_datadog_integration_tc_deploy_040(
        self,
        monitoring_service: MonitoringService
    ):
        """TC-DEPLOY-040: Test Datadog monitoring integration"""
        # Test metric submission
        with patch('datadog.statsd.gauge') as mock_gauge:
            await monitoring_service.record_metric(
                name="custom.metric",
                value=42.5,
                tags=["environment:production", "service:api"]
            )
            
            mock_gauge.assert_called_with(
                "nyelux.custom.metric",
                42.5,
                tags=["environment:production", "service:api"]
            )
        
        # Test APM tracing
        with patch('ddtrace.tracer.trace') as mock_trace:
            async with monitoring_service.trace_operation("database.query"):
                # Simulate database operation
                await asyncio.sleep(0.1)
            
            mock_trace.assert_called()
        
        # Test custom events
        with patch('datadog.api.Event.create') as mock_event:
            await monitoring_service.send_event(
                title="Deployment Started",
                text="Deploying version 2.6.0 to production",
                alert_type="info",
                tags=["deployment", "production"]
            )
            
            mock_event.assert_called_once()
    
    @pytest.mark.asyncio
    async def test_alert_rule_configuration_tc_deploy_041(
        self,
        monitoring_service: MonitoringService,
        db: AsyncSession
    ):
        """TC-DEPLOY-041: Test alert rule configuration and triggering"""
        # Create alert rules
        alert_rules = [
            {
                "name": "high_error_rate",
                "metric": "error_rate",
                "condition": {
                    "operator": ">",
                    "threshold": 5.0,
                    "duration_minutes": 5
                },
                "severity": "critical",
                "channels": ["pagerduty", "slack"],
                "message": "Error rate exceeds 5% for 5 minutes"
            },
            {
                "name": "slow_response_time",
                "metric": "response_time_p95",
                "condition": {
                    "operator": ">",
                    "threshold": 1000,
                    "duration_minutes": 10
                },
                "severity": "warning",
                "channels": ["slack", "email"],
                "message": "95th percentile response time > 1s"
            },
            {
                "name": "low_disk_space",
                "metric": "disk_usage_percent",
                "condition": {
                    "operator": ">",
                    "threshold": 90,
                    "duration_minutes": 1
                },
                "severity": "critical",
                "channels": ["pagerduty"],
                "message": "Disk usage exceeds 90%"
            }
        ]
        
        for rule in alert_rules:
            created_rule = await monitoring_service.create_alert_rule(rule)
            assert created_rule["id"] is not None
            assert created_rule["active"] is True
        
        # Simulate metric breach
        for i in range(6):  # 6 minutes of high error rate
            await monitoring_service.record_metric("error_rate", 7.5)
            await asyncio.sleep(0.1)  # Simulated time
        
        # Check if alert triggered
        triggered_alerts = await monitoring_service.get_triggered_alerts(
            time_window_minutes=10
        )
        
        assert len(triggered_alerts) > 0
        high_error_alert = next(
            (a for a in triggered_alerts if a["rule_name"] == "high_error_rate"),
            None
        )
        assert high_error_alert is not None
        assert high_error_alert["severity"] == "critical"
        
        # Verify notifications sent
        notifications = await monitoring_service.get_sent_notifications(
            alert_id=high_error_alert["id"]
        )
        
        assert len(notifications) == 2  # PagerDuty and Slack
        assert any(n["channel"] == "pagerduty" for n in notifications)
        assert any(n["channel"] == "slack" for n in notifications)
    
    @pytest.mark.asyncio
    async def test_sla_monitoring_tc_deploy_042(
        self,
        monitoring_service: MonitoringService
    ):
        """TC-DEPLOY-042: Test SLA monitoring and reporting"""
        # Define SLA targets
        sla_config = {
            "availability": {
                "target": 99.9,  # 99.9% uptime
                "measurement_window": "monthly"
            },
            "response_time": {
                "p50": 100,  # 50th percentile < 100ms
                "p95": 500,  # 95th percentile < 500ms
                "p99": 1000  # 99th percentile < 1s
            },
            "error_rate": {
                "target": 0.1  # Less than 0.1%
            }
        }
        
        # Record metrics for SLA calculation
        metrics_data = {
            "uptime_seconds": 2591700,  # 29.99 days
            "total_seconds": 2592000,   # 30 days
            "response_times": [50, 75, 90, 100, 120, 150, 200, 450, 600, 950],
            "total_requests": 1000000,
            "error_count": 500
        }
        
        # Calculate SLA compliance
        sla_report = await monitoring_service.calculate_sla_compliance(
            config=sla_config,
            metrics=metrics_data
        )
        
        # Check availability SLA
        assert sla_report["availability"]["actual"] == 99.988  # 29.99/30 days
        assert sla_report["availability"]["meets_sla"] is True
        
        # Check response time SLA
        assert sla_report["response_time"]["p50"]["actual"] < 100
        assert sla_report["response_time"]["p95"]["actual"] < 500
        assert sla_report["response_time"]["p99"]["actual"] < 1000
        assert sla_report["response_time"]["meets_sla"] is True
        
        # Check error rate SLA
        assert sla_report["error_rate"]["actual"] == 0.05  # 0.05%
        assert sla_report["error_rate"]["meets_sla"] is True
        
        # Overall SLA status
        assert sla_report["overall_sla_met"] is True
    
