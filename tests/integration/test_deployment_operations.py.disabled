class TestDeploymentStrategy:
    """Test deployment strategies and zero-downtime deployments"""
    
    @pytest.mark.asyncio
    async def test_blue_green_deployment_tc_deploy_001(
        self,
        client: AsyncClient,
        db: AsyncSession,
        deployment_service: DeploymentService
    ):
        """TC-DEPLOY-001: Test blue-green deployment strategy"""
        # Setup
        current_version = "v1.0.0"
        new_version = "v1.1.0"
        
        # Create deployment configuration
        deployment_config = {
            "strategy": "blue-green",
            "blue_environment": {
                "version": current_version,
                "instances": 4,
                "health_check_url": "/health",
                "load_balancer": "blue-lb"
            },
            "green_environment": {
                "version": new_version,
                "instances": 4,
                "health_check_url": "/health",
                "load_balancer": "green-lb"
            },
            "rollback_enabled": True,
            "health_check_timeout": 300,  # 5 minutes
            "traffic_switch_method": "weighted"
        }
        
        # Start deployment
        deployment_id = await deployment_service.start_deployment(
            config=deployment_config,
            initiated_by="ci-pipeline"
        )
        
        # Deploy to green environment
        green_deployment = await deployment_service.deploy_to_environment(
            deployment_id=deployment_id,
            environment="green",
            version=new_version
        )
        
        assert green_deployment["status"] == "deploying"
        assert green_deployment["instances_deployed"] == 0
        
        # Simulate instance deployment
        for i in range(4):
            await deployment_service.update_instance_status(
                deployment_id=deployment_id,
                environment="green",
                instance_id=f"green-{i}",
                status="healthy"
            )
        
        # Run health checks
        health_status = await deployment_service.run_health_checks(
            deployment_id=deployment_id,
            environment="green"
        )
        
        assert health_status["healthy_instances"] == 4
        assert health_status["overall_status"] == "healthy"
        
        # Switch traffic gradually
        traffic_switches = [
            {"blue": 90, "green": 10},  # Canary
            {"blue": 50, "green": 50},  # 50/50
            {"blue": 10, "green": 90},  # Almost complete
            {"blue": 0, "green": 100}   # Full switch
        ]
        
        for weights in traffic_switches:
            result = await deployment_service.update_traffic_weights(
                deployment_id=deployment_id,
                weights=weights
            )
            
            assert result["current_weights"] == weights
            
            # Simulate monitoring during traffic shift
            metrics = await deployment_service.get_deployment_metrics(
                deployment_id=deployment_id
            )
            
            assert metrics["error_rate"] < 0.01  # Less than 1% errors
            assert metrics["response_time_p95"] < 200  # Under 200ms
            
            # Small delay between switches
            await asyncio.sleep(0.1)
        
        # Complete deployment
        completion = await deployment_service.complete_deployment(
            deployment_id=deployment_id
        )
        
        assert completion["status"] == "completed"
        assert completion["active_environment"] == "green"
        assert completion["deployment_duration"] < 600  # Under 10 minutes
    
    @pytest.mark.asyncio
    async def test_rollback_on_failure_tc_deploy_002(
        self,
        deployment_service: DeploymentService,
        monitoring_service: MonitoringService
    ):
        """TC-DEPLOY-002: Test automatic rollback on deployment failure"""
        # Start deployment
        deployment_config = {
            "strategy": "blue-green",
            "rollback_enabled": True,
            "rollback_triggers": {
                "error_rate_threshold": 0.05,  # 5%
                "response_time_threshold": 500,  # ms
                "health_check_failures": 2
            }
        }
        
        deployment_id = await deployment_service.start_deployment(
            config=deployment_config
        )
        
        # Deploy new version
        await deployment_service.deploy_to_environment(
            deployment_id=deployment_id,
            environment="green",
            version="v1.2.0-buggy"
        )
        
        # Simulate deployment issues
        await monitoring_service.record_metric(
            metric_name="deployment.error_rate",
            value=0.08,  # 8% error rate
            tags={"deployment_id": deployment_id}
        )
        
        # Check rollback trigger
        rollback_triggered = await deployment_service.check_rollback_conditions(
            deployment_id=deployment_id
        )
        
        assert rollback_triggered is True
        
        # Execute rollback
        rollback_result = await deployment_service.execute_rollback(
            deployment_id=deployment_id,
            reason="High error rate detected"
        )
        
        assert rollback_result["status"] == "rolled_back"
        assert rollback_result["rollback_duration"] < 60  # Under 1 minute
        assert rollback_result["traffic_restored_to"] == "blue"
        
        # Verify system stability after rollback
        post_rollback_metrics = await monitoring_service.get_current_metrics()
        assert post_rollback_metrics["error_rate"] < 0.01
    
    @pytest.mark.asyncio
    async def test_database_migration_during_deployment_tc_deploy_003(
        self,
        deployment_service: DeploymentService,
        db: AsyncSession
    ):
        """TC-DEPLOY-003: Test database migration handling during deployment"""
        # Create migration plan
        migration_plan = {
            "version": "20240115_add_analytics_tables",
            "type": "forward",
            "steps": [
                {
                    "step": 1,
                    "description": "Add analytics_events table",
                    "sql": """
                        CREATE TABLE IF NOT EXISTS analytics_events_new (
                            id BIGSERIAL PRIMARY KEY,
                            event_type VARCHAR(100),
                            user_id INTEGER,
                            created_at TIMESTAMP DEFAULT NOW()
                        )
                    """,
                    "rollback_sql": "DROP TABLE IF EXISTS analytics_events_new"
                },
                {
                    "step": 2,
                    "description": "Create indexes",
                    "sql": """
                        CREATE INDEX idx_analytics_events_user 
                        ON analytics_events_new(user_id)
                    """,
                    "rollback_sql": "DROP INDEX IF EXISTS idx_analytics_events_user"
                }
            ],
            "compatibility": "backward",  # Old code can work with new schema
            "estimated_duration": 30  # seconds
        }
        
        # Start deployment with migration
        deployment_id = await deployment_service.start_deployment(
            config={
                "strategy": "blue-green",
                "database_migration": migration_plan
            }
        )
        
        # Execute migration
        migration_result = await deployment_service.execute_migration(
            deployment_id=deployment_id,
            plan=migration_plan
        )
        
        assert migration_result["status"] == "completed"
        assert migration_result["steps_completed"] == 2
        assert migration_result["duration"] < 60  # Under 1 minute
        
        # Verify migration
        result = await db.execute("""
            SELECT EXISTS (
                SELECT FROM information_schema.tables 
                WHERE table_name = 'analytics_events_new'
            )
        """)
        table_exists = result.scalar()
        assert table_exists is True
        
        # Test rollback capability
        rollback_result = await deployment_service.rollback_migration(
            deployment_id=deployment_id,
            plan=migration_plan
        )
        
        assert rollback_result["status"] == "rolled_back"
    
    @pytest.mark.asyncio
    async def test_cache_warming_during_deployment_tc_deploy_004(
        self,
        deployment_service: DeploymentService,
        redis_client: aioredis.Redis
    ):
        """TC-DEPLOY-004: Test cache warming during deployment"""
        # Define cache warming strategy
        warming_config = {
            "strategies": [
                {
                    "name": "popular_devices",
                    "query": "SELECT * FROM devices ORDER BY view_count DESC LIMIT 1000",
                    "cache_key_pattern": "device:{}",
                    "ttl": 3600
                },
                {
                    "name": "user_sessions",
                    "source": "active_sessions",
                    "cache_key_pattern": "session:{}",
                    "ttl": 86400
                },
                {
                    "name": "search_results",
                    "top_searches": 100,
                    "cache_key_pattern": "search:{}",
                    "ttl": 900
                }
            ],
            "parallel_workers": 4,
            "batch_size": 100
        }
        
        # Start cache warming
        warming_result = await deployment_service.warm_cache(
            deployment_id="deploy-123",
            config=warming_config,
            target_environment="green"
        )
        
        assert warming_result["total_keys_warmed"] > 0
        assert warming_result["strategies_completed"] == 3
        assert warming_result["duration"] < 300  # Under 5 minutes
        
        # Verify cache hit rate improvement
        initial_hit_rate = 0.0
        final_hit_rate = await deployment_service.get_cache_hit_rate(
            environment="green"
        )
        
        assert final_hit_rate > 0.8  # 80% hit rate after warming
        
        # Test specific cache entries
        popular_device = await redis_client.get("device:1")
        assert popular_device is not None
    
    @pytest.mark.asyncio
    async def test_feature_flag_deployment_tc_deploy_005(
        self,
        deployment_service: DeploymentService,
        feature_flag_service: FeatureFlagService
    ):
        """TC-DEPLOY-005: Test feature flag controlled deployment"""
        # Create feature flags for new features
        flags = [
            {
                "name": "new_ai_chat",
                "description": "Enhanced AI chat with GPT-4",
                "default_enabled": False,
                "rollout_percentage": 0,
                "targeting_rules": []
            },
            {
                "name": "advanced_analytics",
                "description": "New analytics dashboard",
                "default_enabled": False,
                "rollout_percentage": 0,
                "targeting_rules": []
            }
        ]
        
        for flag in flags:
            await feature_flag_service.create_flag(flag)
        
        # Deploy with feature flags
        deployment_config = {
            "version": "v2.0.0",
            "feature_flags": {
                "new_ai_chat": {
                    "rollout_strategy": "percentage",
                    "stages": [
                        {"percentage": 5, "duration_hours": 24},
                        {"percentage": 25, "duration_hours": 48},
                        {"percentage": 50, "duration_hours": 72},
                        {"percentage": 100, "duration_hours": None}
                    ]
                },
                "advanced_analytics": {
                    "rollout_strategy": "targeted",
                    "targets": [
                        {"type": "organization", "ids": [1, 2, 3]},
                        {"type": "role", "values": ["super_admin"]}
                    ]
                }
            }
        }
        
        deployment_id = await deployment_service.start_deployment(
            config=deployment_config
        )
        
        # Test gradual rollout
        for stage in deployment_config["feature_flags"]["new_ai_chat"]["stages"]:
            result = await feature_flag_service.update_rollout_percentage(
                flag_name="new_ai_chat",
                percentage=stage["percentage"]
            )
            
            assert result["current_percentage"] == stage["percentage"]
            
            # Verify flag evaluation for different users
            enabled_count = 0
            for i in range(100):
                user_context = {"user_id": i, "organization_id": 1}
                is_enabled = await feature_flag_service.is_enabled(
                    flag_name="new_ai_chat",
                    context=user_context
                )
                if is_enabled:
                    enabled_count += 1
            
            # Allow some variance in percentage
            expected = stage["percentage"]
            assert abs(enabled_count - expected) < 10
    
    @pytest.mark.asyncio
    async def test_canary_deployment_tc_deploy_006(
        self,
        deployment_service: DeploymentService,
        monitoring_service: MonitoringService
    ):
        """TC-DEPLOY-006: Test canary deployment with automatic promotion"""
        # Configure canary deployment
        canary_config = {
            "strategy": "canary",
            "initial_percentage": 5,
            "increment_percentage": 20,
            "increment_interval_minutes": 30,
            "success_criteria": {
                "error_rate_threshold": 0.01,  # 1%
                "response_time_p99": 500,  # ms
                "cpu_usage_max": 80,  # percentage
                "memory_usage_max": 85  # percentage
            },
            "monitoring_duration_minutes": 15
        }
        
        deployment_id = await deployment_service.start_canary_deployment(
            config=canary_config,
            version="v1.3.0"
        )
        
        # Monitor canary performance
        stages = [5, 25, 45, 65, 85, 100]
        for target_percentage in stages:
            # Update traffic split
            await deployment_service.update_canary_traffic(
                deployment_id=deployment_id,
                percentage=target_percentage
            )
            
            # Simulate monitoring period
            monitoring_result = await monitoring_service.monitor_canary(
                deployment_id=deployment_id,
                duration_seconds=60  # Shortened for test
            )
            
            # Check success criteria
            meets_criteria = all([
                monitoring_result["error_rate"] < canary_config["success_criteria"]["error_rate_threshold"],
                monitoring_result["response_time_p99"] < canary_config["success_criteria"]["response_time_p99"],
                monitoring_result["cpu_usage"] < canary_config["success_criteria"]["cpu_usage_max"],
                monitoring_result["memory_usage"] < canary_config["success_criteria"]["memory_usage_max"]
            ])
            
            assert meets_criteria is True
            
            # Log promotion
            logger.info(f"Canary promoted to {target_percentage}% traffic")
        
        # Complete canary deployment
        completion = await deployment_service.complete_canary(
            deployment_id=deployment_id
        )
        
        assert completion["final_percentage"] == 100
        assert completion["total_duration_minutes"] < 180  # Under 3 hours


class TestMonitoringObservability:
    """Test monitoring and observability features"""
    
    @pytest.mark.asyncio
    async def test_application_metrics_collection_tc_deploy_007(
        self,
        monitoring_service: MonitoringService,
        client: AsyncClient
    ):
        """TC-DEPLOY-007: Test application metrics collection"""
        # Generate some application activity
        endpoints = [
            "/api/v1/devices/search",
            "/api/v1/auth/login",
            "/api/v1/chat/conversations",
            "/health"
        ]
        
        for endpoint in endpoints:
            for _ in range(10):
                if endpoint == "/api/v1/auth/login":
                    response = await client.post(endpoint, json={
                        "username": "test@example.com",
                        "password": "password"
                    })
                else:
                    response = await client.get(endpoint)
        
        # Collect metrics
        metrics = await monitoring_service.collect_application_metrics()
        
        # Verify metric categories
        assert "request_rate" in metrics
        assert "error_rate" in metrics
        assert "response_time" in metrics
        assert "active_users" in metrics
        assert "database_connections" in metrics
        
        # Check specific metrics
        assert metrics["request_rate"]["total"] > 0
        assert metrics["response_time"]["p95"] < 500  # Under 500ms
        assert metrics["error_rate"]["percentage"] < 5  # Under 5%
        
        # Verify Prometheus format
        prometheus_metrics = await monitoring_service.export_prometheus_metrics()
        
        families = list(text_string_to_metric_families(prometheus_metrics))
        metric_names = [family.name for family in families]
        
        expected_metrics = [
            "http_requests_total",
            "http_request_duration_seconds",
            "http_requests_in_progress",
            "database_connections_active",
            "cache_hit_ratio"
        ]
        
        for expected in expected_metrics:
            assert expected in metric_names
    
    @pytest.mark.asyncio
    async def test_distributed_tracing_tc_deploy_008(
        self,
        monitoring_service: MonitoringService,
        client: AsyncClient
    ):
        """TC-DEPLOY-008: Test distributed tracing implementation"""
        # Make a request that spans multiple services
        headers = {
            "X-Trace-ID": "test-trace-123",
            "X-Span-ID": "root-span"
        }
        
        response = await client.post(
            "/api/v1/devices/search",
            json={"query": "infusion pump"},
            headers=headers
        )
        
        # Get trace data
        trace = await monitoring_service.get_trace("test-trace-123")
        
        assert trace is not None
        assert len(trace["spans"]) > 1
        
        # Verify trace structure
        root_span = next(s for s in trace["spans"] if s["id"] == "root-span")
        assert root_span["operation"] == "POST /api/v1/devices/search"
        
        # Check for expected spans
        span_operations = [span["operation"] for span in trace["spans"]]
        expected_operations = [
            "auth.verify_token",
            "database.query",
            "elasticsearch.search",
            "cache.get",
            "response.serialize"
        ]
        
        for expected_op in expected_operations:
            assert any(expected_op in op for op in span_operations)
        
        # Verify timing data
        total_duration = trace["duration_ms"]
        assert total_duration < 500  # Under 500ms
        
        # Check for errors in trace
        error_spans = [s for s in trace["spans"] if s.get("error")]
        assert len(error_spans) == 0
    
    @pytest.mark.asyncio
    async def test_error_tracking_and_alerting_tc_deploy_009(
        self,
        monitoring_service: MonitoringService,
        db: AsyncSession
    ):
        """TC-DEPLOY-009: Test error tracking and alerting"""
        # Configure error alerts
        alert_rules = [
            {
                "name": "high_error_rate",
                "condition": "error_rate > 5",
                "window_minutes": 5,
                "severity": "critical",
                "channels": ["pagerduty", "slack"]
            },
            {
                "name": "database_connection_pool",
                "condition": "db_connections_used > 90",
                "window_minutes": 1,
                "severity": "warning",
                "channels": ["slack"]
            },
            {
                "name": "response_time_degradation",
                "condition": "response_time_p95 > 1000",
                "window_minutes": 10,
                "severity": "warning",
                "channels": ["email"]
            }
        ]
        
        for rule in alert_rules:
            await monitoring_service.create_alert_rule(rule)
        
        # Simulate errors
        error_types = [
            {"type": "ValueError", "message": "Invalid device ID"},
            {"type": "DatabaseError", "message": "Connection timeout"},
            {"type": "AuthenticationError", "message": "Invalid token"}
        ]
        
        for error in error_types:
            for _ in range(3):
                await monitoring_service.track_error(
                    error_type=error["type"],
                    error_message=error["message"],
                    stack_trace="Full stack trace here...",
                    context={
                        "user_id": 123,
                        "endpoint": "/api/v1/devices/search",
                        "request_id": "req-456"
                    }
                )
        
        # Check error aggregation
        error_summary = await monitoring_service.get_error_summary(
            time_window_minutes=60
        )
        
        assert error_summary["total_errors"] == 9
        assert len(error_summary["errors_by_type"]) == 3
        assert error_summary["top_error"]["count"] == 3
        
        # Verify Sentry integration
        with patch('sentry_sdk.capture_exception') as mock_sentry:
            try:
                raise ValueError("Test error for Sentry")
            except Exception as e:
                await monitoring_service.report_exception(e)
            
            mock_sentry.assert_called_once()
    
    @pytest.mark.asyncio
    async def test_infrastructure_monitoring_tc_deploy_010(
        self,
        monitoring_service: MonitoringService
    ):
        """TC-DEPLOY-010: Test infrastructure monitoring"""
        # Collect infrastructure metrics
        infra_metrics = await monitoring_service.collect_infrastructure_metrics()
        
        # Verify system metrics
        assert "cpu" in infra_metrics
        assert "memory" in infra_metrics
        assert "disk" in infra_metrics
        assert "network" in infra_metrics
        
        # Check CPU metrics
        cpu_metrics = infra_metrics["cpu"]
        assert 0 <= cpu_metrics["usage_percent"] <= 100
        assert cpu_metrics["load_average"]["1m"] >= 0
        
        # Check memory metrics
        memory_metrics = infra_metrics["memory"]
        assert memory_metrics["used_percent"] < 90  # Alert if over 90%
        assert memory_metrics["available_gb"] > 1
        
        # Check disk metrics
        disk_metrics = infra_metrics["disk"]
        assert disk_metrics["used_percent"] < 80  # Alert if over 80%
        assert disk_metrics["iops"]["read"] >= 0
        assert disk_metrics["iops"]["write"] >= 0
        
        # Check container metrics (if running in container)
        if await monitoring_service.is_containerized():
            container_metrics = await monitoring_service.get_container_metrics()
            
            assert container_metrics["container_count"] > 0
            assert "cpu_throttled_percentage" in container_metrics
            assert "memory_limit_gb" in container_metrics
    
    @pytest.mark.asyncio
    async def test_log_aggregation_and_search_tc_deploy_011(
        self,
        monitoring_service: MonitoringService,
        client: AsyncClient
    ):
        """TC-DEPLOY-011: Test log aggregation and search"""
        # Generate various log entries
        log_entries = [
            {
                "level": "INFO",
                "message": "User login successful",
                "user_id": 123,
                "ip_address": "192.168.1.1"
            },
            {
                "level": "WARNING",
                "message": "Rate limit approaching",
                "endpoint": "/api/v1/devices/search",
                "current_rate": 95
            },
            {
                "level": "ERROR",
                "message": "Database connection failed",
                "error": "timeout after 30s",
                "retry_count": 3
            }
        ]
        
        for entry in log_entries:
            logger.log(
                getattr(logging, entry["level"]),
                entry["message"],
                extra={k: v for k, v in entry.items() if k not in ["level", "message"]}
            )
        
        # Search logs
        search_results = await monitoring_service.search_logs(
            query="user_id:123",
            time_range="last_hour",
            limit=10
        )
        
        assert len(search_results["results"]) > 0
        assert search_results["results"][0]["user_id"] == 123
        
        # Test log parsing
        parsed_logs = await monitoring_service.parse_structured_logs(
            log_pattern=r"(?P<timestamp>\S+) (?P<level>\S+) (?P<message>.*)"
        )
        
        assert len(parsed_logs) > 0
        
        # Test log retention
        retention_info = await monitoring_service.get_log_retention_info()
        assert retention_info["retention_days"] == 30
        assert retention_info["total_size_gb"] < 100
    
    @pytest.mark.asyncio
    async def test_performance_profiling_tc_deploy_012(
        self,
        monitoring_service: MonitoringService,
        client: AsyncClient
    ):
        """TC-DEPLOY-012: Test performance profiling capabilities"""
        # Enable profiling for specific endpoint
        await monitoring_service.enable_profiling(
            endpoint="/api/v1/devices/search",
            sample_rate=1.0  # 100% for testing
        )
        
        # Make requests to profile
        for _ in range(5):
            await client.post(
                "/api/v1/devices/search",
                json={"query": "test", "filters": {"class": "II"}}
            )
        
        # Get profiling data
        profile_data = await monitoring_service.get_profile_data(
            endpoint="/api/v1/devices/search"
        )
        
        assert profile_data is not None
        assert "cpu_time" in profile_data
        assert "memory_allocations" in profile_data
        assert "database_queries" in profile_data
        
        # Analyze performance bottlenecks
        bottlenecks = await monitoring_service.analyze_bottlenecks(
            profile_data=profile_data
        )
        
        assert len(bottlenecks) >= 0
        if bottlenecks:
            top_bottleneck = bottlenecks[0]
            assert "function" in top_bottleneck
            assert "time_percentage" in top_bottleneck
            assert top_bottleneck["time_percentage"] <= 100
        
        # Disable profiling
        await monitoring_service.disable_profiling(
            endpoint="/api/v1/devices/search"
        )


class TestHealthChecksAndReadiness:
    """Test health check and readiness probe implementations"""
    
    @pytest.mark.asyncio
    async def test_comprehensive_health_check_tc_deploy_013(
        self,
        health_check_service: HealthCheckService,
        client: AsyncClient
    ):
        """TC-DEPLOY-013: Test comprehensive health check endpoint"""
        # Perform health check
        response = await client.get("/health")
        assert response.status_code == 200
        
        health_data = response.json()
        
        # Verify all components checked
        expected_components = [
            "database",
            "redis",
            "elasticsearch",
            "s3",
            "openai",
            "email_service",
            "background_jobs"
        ]
        
        for component in expected_components:
            assert component in health_data["components"]
            component_health = health_data["components"][component]
            assert "status" in component_health
            assert "response_time_ms" in component_health
            assert component_health["status"] in ["healthy", "degraded", "unhealthy"]
        
        # Check overall status
        assert health_data["overall_status"] in ["healthy", "degraded", "unhealthy"]
        assert health_data["version"] == settings.APP_VERSION
        assert "timestamp" in health_data
    
    @pytest.mark.asyncio
    async def test_readiness_probe_tc_deploy_014(
        self,
        health_check_service: HealthCheckService,
        client: AsyncClient
    ):
        """TC-DEPLOY-014: Test Kubernetes readiness probe"""
        # Test readiness endpoint
        response = await client.get("/ready")
        
        if response.status_code == 200:
            ready_data = response.json()
            assert ready_data["ready"] is True
            assert ready_data["initialized"] is True
            
            # Verify critical services ready
            assert ready_data["database_migrations"] == "completed"
            assert ready_data["cache_warmed"] is True
            assert ready_data["background_workers"] > 0
        else:
            # Service not ready
            assert response.status_code == 503
            not_ready_data = response.json()
            assert not_ready_data["ready"] is False
            assert "reasons" in not_ready_data
    
    @pytest.mark.asyncio
    async def test_liveness_probe_tc_deploy_015(
        self,
        client: AsyncClient
    ):
        """TC-DEPLOY-015: Test Kubernetes liveness probe"""
        # Test liveness endpoint
        response = await client.get("/alive")
        
        assert response.status_code == 200
        alive_data = response.json()
        
        assert alive_data["alive"] is True
        assert "uptime_seconds" in alive_data
        assert alive_data["uptime_seconds"] > 0
        
        # Test should be lightweight - no external dependencies
        assert "pid" in alive_data
        assert alive_data["pid"] == os.getpid()
    
    @pytest.mark.asyncio
    async def test_dependency_health_checks_tc_deploy_016(
        self,
